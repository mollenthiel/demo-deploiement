#!/bin/sh
# Monte un environnement de dev ou de test depuis zero, sur le bac de celui qui le lance.
#   DATABASE_URL=postgresql://... bin/installer-dev
# Prerequis du bac : PHP 8.5 avec pdo_pgsql, une base PostgreSQL vide a soi.
# Ecrit .env.local (secret genere ici, jamais copie d'un autre cote), passe les
# migrations, charge les donnees fictives, lance les tests.
set -eu
cd "$(dirname "$0")/.."
: "${DATABASE_URL:?DATABASE_URL de ta propre base de dev attendue}"
if [ ! -e .env.local ]; then
  umask 077
  sed -e "s|^APP_SECRET=.*|APP_SECRET=$(od -An -tx1 -N16 /dev/urandom | tr -d ' \n')|" \
      -e "s|^DATABASE_URL=.*|DATABASE_URL=$DATABASE_URL|" .env.exemple > .env.local
  umask 022
fi
php bin/migrer.php
php -r 'require "src/Base.php"; $e = Base::env("."); $p = Base::pdo($e["DATABASE_URL"]);
  if (!$p->query("SELECT count(*) FROM rendez_vous")->fetchColumn()) { $p->exec(file_get_contents("fixtures/fictives.sql")); echo "donnees fictives chargees\n"; }'
sh deploiement/tester
echo "pret : php -S 127.0.0.1:8000 -t public"
